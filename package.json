{
	"name": "iconclass-classification",
	"description": "Reproducible pipeline to classify digital objects using Iconclass VLM via Ollama",
	"author": "Stadt Geschichte Basel <info@stadtgeschichtebasel.ch>",
	"url": "https://github.com/Stadt-Geschichte-Basel/iconclass-classification/issues",
	"license": "AGPL-3.0",
	"scripts": {
		"check": "prettier --check .",
		"commit": "cz",
		"deadlink-check": ".github/scripts/deadlink-check.sh",
		"format": "prettier --write .",
		"prepare": "husky",
		"changelog": "npm exec git-cliff -- --config cliff.toml"
	},
	"devDependencies": {
		"commitizen": "^4.3.1",
		"cz": "^1.8.2",
		"cz-conventional-changelog": "^3.3.0",
		"git-cliff": "^2.10.1",
		"husky": "^9.1.7",
		"prettier": "^3.6.2"
	},
	"type": "module",
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	}
}
